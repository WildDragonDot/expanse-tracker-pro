{
  "name": "expense-tracker-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma generate && next build",
    "start": "next start -p 3001",
    "deploy": "prisma db push && npm run start",
    "render-build": "npm install && prisma generate && next build",
    "test": "jest --config jest.config.js --runInBand",
    "test:watch": "jest --config jest.config.js --watch",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "setup": "node setup-database.js",
    "verify": "node verify-integration.js",
    "db:reset": "prisma db push --force-reset && prisma generate",
    "check-expired-shopping": "node scripts/check-expired-shopping.js",
    "check-expiry": "node scripts/check-category-expiry.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.946.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "next": "^14.2.33",
    "nodemailer": "^7.0.11",
    "pdfkit": "^0.17.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.8.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.4",
    "@types/pdfkit": "^0.17.4",
    "@types/react": "19.2.14",
    "fast-check": "^4.3.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prisma": "^5.20.0",
    "typescript": "^5"
  }
}
