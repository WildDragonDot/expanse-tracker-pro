{
  "expo": {
    "name": "Expense Tracker",
    "slug": "financetracker-pro",
    "scheme": "financetracker-pro",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070A13",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070A13"
    },
    "android": {
      "package": "com.gsvinfotech.expensetracker",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#070A13",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "CAMERA",
        "INTERNET",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "androidStatusBar": {
      "hidden": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7544180796220594~5716479610",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "react-native-google-mobile-ads": {
      "android_app_id": "ca-app-pub-7544180796220594~5716479610",
      "ios_app_id": "ca-app-pub-3940256099942544~1458002511"
    },
    "extra": {
      "eas": {
        "projectId": "f0fd86a6-8c91-450c-9b78-a90900abd0e0"
      }
    }
  }
}
